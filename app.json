{
  "expo": {
    "name": "Mast Magan",
    "slug": "mastmaganapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mast-magan-icon.jpg",
    "scheme": "mastmaganapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mast-magan-icon.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#140C07",
        "foregroundImage": "./assets/images/mast-magan-icon.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mast-magan-icon.jpg"
    },
    "splash": {
      "image": "./assets/images/premium-splash.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#140C07"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#140C07",
          "image": "./assets/images/premium-splash.jpg",
          "resizeMode": "cover"
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
